{
  "name": "jalingo-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API for the Eland FC club site and the Jalingo Football League management system",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed/run.js",
    "reseed": "node --disable-warning=ExperimentalWarning src/seed/run.js --force",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js"
  }
}
